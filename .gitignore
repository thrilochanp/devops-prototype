infra/**/*-config
!*.tfvars.example
crash.log
.terraform.lock.hcl.bak

# Secrets that must never be committed (sealed versions are fine)
*.unsealed.yaml
sealed-secrets-key*.yaml
.env

# Editors
.vscode/
.idea/
